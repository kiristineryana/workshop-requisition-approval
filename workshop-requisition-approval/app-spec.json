  "webResources": [
    {
      "name": "wksp_requisition.js",
      "displayName": "Workshop Requisition Form Scripts",
      "type": "js",
      "content": "var Wksp = window.Wksp || {};\nWksp.Requisition = {\n  STATUS_DRAFT: 100000000,\n  onLoad: function (executionContext) {\n    var formContext = executionContext.getFormContext();\n    Wksp.Requisition.toggleApproverVisibility(formContext);\n    Wksp.Requisition.toggleJustificationRequired(formContext);\n  },\n  onStatusChange: function (executionContext) {\n    Wksp.Requisition.toggleApproverVisibility(executionContext.getFormContext());\n  },\n  onTotalValueChange: function (executionContext) {\n    Wksp.Requisition.toggleJustificationRequired(executionContext.getFormContext());\n  },\n  toggleApproverVisibility: function (formContext) {\n    var statusAttr = formContext.getAttribute('wksp_status');\n    var approverControl = formContext.getControl('wksp_currentapproverid');\n    if (!statusAttr || !approverControl) return;\n    approverControl.setVisible(statusAttr.getValue() !== Wksp.Requisition.STATUS_DRAFT);\n  },\n  toggleJustificationRequired: function (formContext) {\n    var totalAttr = formContext.getAttribute('wksp_totalvalue');\n    var justificationAttr = formContext.getAttribute('wksp_justification');\n    if (!totalAttr || !justificationAttr) return;\n    var total = totalAttr.getValue() || 0;\n    justificationAttr.setRequiredLevel(total >= 10000 ? 'required' : 'none');\n  }\n};\n\nWksp.LineItem = {\n  onLoad: function (executionContext) {\n    var formContext = executionContext.getFormContext();\n    Wksp.LineItem.recalculateLineTotal(formContext);\n    Wksp.LineItem.lockIfRequisitionNotEditable(formContext);\n  },\n  onQuantityOrPriceChange: function (executionContext) {\n    Wksp.LineItem.recalculateLineTotal(executionContext.getFormContext());\n  },\n  recalculateLineTotal: function (formContext) {\n    var qtyAttr = formContext.getAttribute('wksp_quantity');\n    var priceAttr = formContext.getAttribute('wksp_unitprice');\n    var totalAttr = formContext.getAttribute('wksp_linetotal');\n    if (!qtyAttr || !priceAttr || !totalAttr) return;\n    var qty = qtyAttr.getValue() || 0;\n    var price = priceAttr.getValue() || 0;\n    totalAttr.setValue(qty * price);\n  },\n  lockIfRequisitionNotEditable: function (formContext) {\n    var parentAttr = formContext.getAttribute('wksp_parentrequisitionid');\n    if (!parentAttr) return;\n    var parentRef = parentAttr.getValue();\n    if (!parentRef || !parentRef[0]) return;\n    Xrm.WebApi.retrieveRecord('wksp_requisition', parentRef[0].id, '?$select=wksp_status').then(\n      function (result) {\n        var DRAFT = 100000000, SUBMITTED = 100000001;\n        if (result.wksp_status === DRAFT || result.wksp_status === SUBMITTED) return;\n        formContext.ui.controls.forEach(function (control) {\n          if (control.setDisabled) control.setDisabled(true);\n        });\n      },\n      function () { /* new/unsaved parent - leave editable */ }\n    );\n  }\n};"
    }
  ],
